# Copy this file to ".env" (same folder) and fill in your own values.
# The real .env file is secret and is never uploaded to GitHub.

# Anthropic API key - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# MySQL settings (used by the MySQL container and by the backend)
MYSQL_ROOT_PASSWORD=choose-a-root-password
MYSQL_DATABASE=chat_db
MYSQL_USER=chat_user
MYSQL_PASSWORD=choose-a-password

# Where the backend finds MySQL when run without Docker
# (docker-compose overrides DB_HOST to "mysql" automatically)
DB_HOST=localhost
DB_PORT=3306
